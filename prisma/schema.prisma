generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  CLOSED
}

enum AuditSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  PASSED
  FAILED
  CANCELLED
}

model User {
  id             String        @id @default(cuid())
  email             String        @unique
  displayName       String?
  // Identity is delegated to an approved provider; do not store raw passwords here.
  identityProvider  String?
  providerSubject   String?
  emailVerifiedAt   DateTime?
  status            AccountStatus @default(PENDING)
  mfaEnabled        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          AuthSession[]
  challenges        Challenge[]
  auditEvents       AuditEvent[]
  supportTickets    SupportTicket[]
  feedbackItems     FeedbackItem[]
  kycCases          KycCase[]
  withdrawalRequests WithdrawalRequest[]

  @@unique([identityProvider, providerSubject])

  @@index([status, createdAt])
}


// Application sessions store only a digest of a high-entropy opaque token.
// A trusted authentication adapter must create/revoke these; never accept raw tokens from the DB.
model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  userAgentHash String?

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

// This represents a simulated challenge configuration, not customer money.
model Challenge {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             ChallengeStatus @default(DRAFT)
  simulatedStart     Decimal         @db.Decimal(20, 8)
  targetPercent      Decimal         @db.Decimal(8, 4)
  dailyLossLimitPct  Decimal         @db.Decimal(8, 4)
  overallLossLimitPct Decimal        @db.Decimal(8, 4)
  rulesVersion       String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, status])
}

// Append-only audit trail. Application policy must prohibit update/delete for normal runtime roles.
model AuditEvent {
  id          String        @id @default(cuid())
  actorUserId String?
  actor       User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  severity    AuditSeverity @default(INFO)
  requestId   String?
  ipHash      String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
}


enum SupportTicketStatus {
  OPEN
  TRIAGED
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCategory {
  ACCOUNT_ACCESS
  SECURITY
  EXCHANGE
  WALLET
  CHALLENGE
  PAYMENTS
  FEEDBACK
  OTHER
}

// Support data must be access-controlled. Security/financial cases should be restricted to trained staff.
model SupportTicket {
  id             String              @id @default(cuid())
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  reference      String              @unique
  category       SupportCategory
  status         SupportTicketStatus @default(OPEN)
  priority       SupportPriority     @default(NORMAL)
  subject        String              @db.VarChar(120)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  messages       SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  String        // Enforce allowed values in application policy (CUSTOMER, STAFF, SYSTEM).
  body        String        @db.VarChar(5000)
  internal    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model FeedbackItem {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category    String   @db.VarChar(40)
  rating      Int?
  message     String   @db.VarChar(3000)
  page        String?  @db.VarChar(120)
  createdAt   DateTime @default(now())
  triagedAt   DateTime?
  status      String   @default("NEW") @db.VarChar(24)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}


// Verification metadata only. Identity documents and biometric material must stay with an approved KYC provider.
enum KycStatus {
  NOT_STARTED
  PENDING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model KycCase {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  status              KycStatus @default(NOT_STARTED)
  provider            String?
  providerCaseId      String?   @unique
  countryCode         String?   @db.VarChar(2)
  verificationLevel   String?   @db.VarChar(40)
  legalNameMatch      Boolean?
  dateOfBirthMatch    Boolean?
  addressMatch       Boolean?
  reviewedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, status, updatedAt])
  @@index([status, expiresAt])
}

enum WithdrawalStatus {
  REQUESTED
  IDENTITY_CHECK
  RISK_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

// A withdrawal must pass server-side policy checks before approval. Never trust client-side flags.
model WithdrawalRequest {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount                Decimal          @db.Decimal(20, 8)
  assetCode             String           @db.VarChar(20)
  destinationReference  String?          @db.VarChar(200) // Prefer a provider token/reference; avoid unnecessary raw PII.
  beneficiaryNameMatch  Boolean?
  emailVerifiedAtCheck  DateTime?
  kycCaseIdAtCheck      String?
  status                WithdrawalStatus @default(REQUESTED)
  holdReasonCode        String?          @db.VarChar(60)
  providerReference     String?          @unique
  requestedAt           DateTime         @default(now())
  reviewedAt            DateTime?
  completedAt           DateTime?
  updatedAt             DateTime         @updatedAt

  @@index([userId, status, requestedAt])
  @@index([status, requestedAt])
}
