# Copy to .env.local for local development. Never commit real secrets.
DATABASE_URL="postgresql://shieldchain:change-me@localhost:5432/shieldchain?schema=public"
APP_URL="http://localhost:3000"
# Exact HTTPS origin for session management; independent of payment activation.
AUTH_ORIGIN=
# Add provider keys only after selecting and approving a provider.
# AUTH_SECRET="generate-a-long-random-secret"
# OPENAI_API_KEY=""
# PAYMENT_PROVIDER_SECRET=""
# CUSTODY_PROVIDER_SECRET=""
# Merchant billing configuration. Leave disabled until provider onboarding and reviews are complete.
PAYMENTS_MODE=disabled
PAYMENTS_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_APPROVAL_REFERENCE=
PAYMENTS_SECURITY_REVIEW_REFERENCE=
